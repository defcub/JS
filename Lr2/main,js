document.getElementById('btn-task2-2').addEventListener('click', () => {
    clearOutput();
    const personName = prompt("Введіть ваше ім'я:");
    const personAge = prompt("Введіть ваш вік:");

    const isContinue = confirm(`Hello, ${personName}! Your age is ${personAge}. Continue?`);

    if (isContinue) {
        alert("Welcome!");
        printToOutput("Користувач натиснув ОК (Welcome!)");
    } else {
        alert("Goodbye!");
        printToOutput("Користувач натиснув Відміна (Goodbye!)");
    }
});

document.getElementById('btn-task2-3').addEventListener('click', () => {
    clearOutput();
    const userNumber = Number(prompt("Введіть число:"));

    if (userNumber % 2 === 0) {
        alert("Number is even");
        printToOutput(`Число ${userNumber} - парне (even)`);
    } else {
        alert("Number is odd"); 
        printToOutput(`Число ${userNumber} - непарне (odd)`);
    }
});


