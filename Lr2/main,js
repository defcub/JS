// Знаходимо контейнер для виводу результатів
const output = document.getElementById('output');

// Очищає блок перед новим завданням
function clearOutput() {
    output.innerHTML = '';
}

// Допоміжна функція для запису тексту на сторінку
function printToOutput(text) {
    const p = document.createElement('p');
    p.textContent = text;
    output.appendChild(p);
}

