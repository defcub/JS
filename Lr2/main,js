document.getElementById('btn-task1-1').addEventListener('click', () => {
    clearOutput();
    const userName = prompt("Введіть ваше ім'я:");
    alert(`Hello, ${userName}! Welcome to JavaScript`);
    printToOutput(`Привітання для ${userName} показано у alert.`);
});

document.getElementById('btn-task1-2').addEventListener('click', () => {
    clearOutput();
    const age = Number(prompt("Введіть ваш вік:"));
    const currentYear = new Date().getFullYear(); 
    const birthYear = currentYear - age;

    alert(`You were born in ${birthYear}`);
    printToOutput(`Рік народження розраховано: ${birthYear}`);
});

document.getElementById('btn-task1-3').addEventListener('click', () => {
    clearOutput();
    const firstName = prompt("Введіть ваше ім'я:");
    const lastName = prompt("Введіть ваше прізвище:");

    console.log("Your full name is " + firstName + " " + lastName);
    console.log(`Your full name is ${firstName} ${lastName}`);

    printToOutput("Результат виведено у консоль (F12).");
    printToOutput(`Your full name is ${firstName} ${lastName}`);
});


