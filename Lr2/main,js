document.getElementById('btn-task3-1').addEventListener('click', () => {
    clearOutput();
    
    function calculate() {
        let result = 100; 
        
        if (true) {
            let result = 500; 
            console.log("Результат всередині блоку if:", result); 
            printToOutput(`Результат всередині блоку if: ${result}`);
        }
        
        console.log("Результат поза блоком if (але у функції):", result); 
        printToOutput(`Результат поза блоком if (але у функції): ${result}`);
    }
    
    calculate();
    printToOutput("Перевірте консоль (F12) для підтвердження.");
});

document.getElementById('btn-task3-2').addEventListener('click', () => {
    clearOutput();
    const secretNumber = 7 % 10; 
    const guess = Number(prompt("Вгадайте число від 0 до 9:"));

    if (guess === secretNumber) {
        alert("Correct!");
        printToOutput("Correct! Ви вгадали число.");
    } else {
        alert("Wrong!");
        printToOutput(`Wrong! Ваше число: ${guess}, а секретне: ${secretNumber}`);
    }
});

